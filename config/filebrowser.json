{
  "port": 3000,
  "baseURL": "",
  "address": "0.0.0.0",
  "log": "stdout",
  "database": "/root/filebrowser.db",
  "root": "/root/nas_storage",
  "branding": {
    "name": "Home NAS",
    "disableExternal": false,
    "disableUsedPercentage": false
  },
  "defaults": {
    "scope": ".",
    "locale": "vi",
    "viewMode": "list",
    "sorting": {
      "by": "name",
      "asc": false
    },
    "permissions": {
      "admin": false,
      "execute": true,
      "create": true,
      "rename": true,
      "modify": true,
      "delete": true,
      "share": true,
      "download": true
    }
  }
}
